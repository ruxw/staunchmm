# --- Bot (BotFather) ---
BOT_TOKEN=123456:ABC...

# --- MongoDB (Atlas or local) ---
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=middleman_db

# --- Middleman userbot session (creates the deal groups + folder) ---
# API_ID / API_HASH from https://my.telegram.org  |  SESSION_STRING from gen_session.py
API_ID=1234567
API_HASH=abcdef0123456789abcdef0123456789
SESSION_STRING=

# --- Branding / middleman ---
MM_USERNAME=xenyy
MM_USER_ID=123456789            # Telegram User ID of middleman
MIDDLEMAN_CHANNEL_URL=https://t.me/your_channel
VOUCH_CHANNEL_URL=https://t.me/your_vouches
TOS_CHANNEL_URL=https://t.me/your_rules
DEFAULT_UPI_ID=yourname@okaxis
DEFAULT_MM_FEE=50 INR

# --- AI Integration (Optional: Gemini API) ---
GEMINI_API_KEY=

# --- Optional ---
DEAL_ID_PREFIX=x            # deal label = "#" + prefix + number  ->  #x1, #x2 ...
DISPLAY_TZ=Asia/Kolkata     # timezone used only for DISPLAYING deadlines (stored in UTC)
FOLDER_NAME=Deals           # Telegram folder name (max 12 chars)
TAT_POLL_SECONDS=15
